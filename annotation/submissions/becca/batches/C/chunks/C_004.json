    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "the defendant Radford Management Associates, LLC, appeals, as limited by its brief, from so much of an order of the Supreme Court, Westchester County (Walker, J.), dated September 30, 2016, as denied its motion for summary judgment dismissing the amended complaint insofar as asserted against it.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P002",
        "quote": "Ordered that the order is reversed insofar as appealed from, on the law, with costs, and the motion of the defendant Radford Management Associates, LLC, for summary judgment dismissing the amended complaint insofar as asserted against it is granted.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P002",
        "quote": "The plaintiff's decedent allegedly slipped and fell on a puddle of water in the laundry room of his apartment building, which was owned by the defendant Radford Management Associates, LLC (hereinafter the defendant).",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P002",
        "quote": "The decedent was deposed before he died. He testified that, as was his custom, on the day of the incident he visited the laundry room on two occasions in the early morning hours.",
        "statement_status": "testimony_or_record"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P002",
        "quote": "During his first visit, when he went to load some wet clothes into a dryer, he did not notice any water on the laundry room floor. No one else was in the laundry room, and none of the machines was in use. He exited the laundry room without incident.",
        "statement_status": "testimony_or_record"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P002",
        "quote": "He later returned to the laundry room to remove his clothes from the dryer. Again, no one else was in the laundry room and none of the machines was in use. The dryer that he was using had a 30-minute cycle, and it had already come to a stop.",
        "statement_status": "testimony_or_record"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P003",
        "quote": "He removed his clothes from the dryer, and as he took one step away from the dryer to leave the laundry room, he slipped and fell. After he fell, he saw, for the first time, water on the laundry room floor.",
        "statement_status": "testimony_or_record"
      },
      {
        "evidence_id": "E008",
        "passage_id": "P003",
        "quote": "To provide constructive notice, \"a defect must be visible and apparent and it must exist for a sufficient length of time prior to the accident to permit defendant's employees to discover and remedy it\"",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E009",
        "passage_id": "P004",
        "quote": "Here, the evidence submitted by the defendant in support of its motion, including the decedent's deposition testimony, was sufficient to establish, prima facie, that the defendant did not create the alleged hazardous condition or have actual or constructive notice of it",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E010",
        "passage_id": "P004",
        "quote": "In opposition, the plaintiff failed to raise a triable issue of fact.",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E011",
        "passage_id": "P004",
        "quote": "A general awareness that the laundry room floor could become wet was legally insufficient to constitute constructive notice of the particular condition that allegedly caused the decedent to slip and fall",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E012",
        "passage_id": "P005",
        "quote": "Accordingly, the Supreme Court should have granted the defendant's motion for summary judgment dismissing the amended complaint insofar as asserted against it.",
        "statement_status": "current_disposition"
      }
    ]
