    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the plaintiff appeals, as limited by her brief, from so much of an order of the Supreme Court, Queens County (Satterfield, J.), dated September 14, 2009, as granted the defendant’s motion for summary judgment dismissing the complaint.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Ordered that the order is reversed insofar as appealed from, on the law, with costs, and the defendant’s motion for summary judgment dismissing the complaint is denied.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "quote": "The plaintiff allegedly was injured when she tripped and fell on an interior staircase at a premises owned by the defendant.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P001",
        "quote": "The defendant moved for summary judgment based upon the deposition testimony of the parties and his mother, who managed the premises for the defendant.",
        "statement_status": "testimony_or_record"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P001",
        "quote": "The deposition testimony of the plaintiff provided competent evidence that there was a defect in a railing at the defendant’s premises which caused her to fall.",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P002",
        "quote": "The plaintiff further claimed that her boyfriend, in her presence, complained about the defect to the defendant’s mother, who replied “I’ll fix it, I’ll fix it.”",
        "statement_status": "testimony_or_record"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P002",
        "quote": "Contrary to the defendant’s contention, the plaintiff’s testimony that she overheard her boyfriend’s statements was admissible evidence that notice of the defect was in fact given, and not hearsay",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E008",
        "passage_id": "P002",
        "quote": "In view of the foregoing, the defendant failed to establish his entitlement to judgment as a matter of law.",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E009",
        "passage_id": "P002",
        "quote": "Accordingly, his motion for summary judgment dismissing the complaint should have been denied.",
        "statement_status": "current_disposition"
