    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "statement_status": "procedural_history",
        "quote": "Appeal from an order of the Supreme Court, Chautauqua County (James H. Dillon, J.), entered April 29, 2009 in a personal injury action. The order denied defendant’s motion for summary judgment."
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "statement_status": "current_disposition",
        "quote": "It is hereby ordered that the order so appealed from is unanimously reversed on the law without costs, the motion is granted, and the complaint is dismissed."
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "statement_status": "testimony_or_record",
        "quote": "Plaintiff commenced this action seeking damages for injuries she sustained when she slipped and fell on snow and ice in a parking area located in front of a post office."
      },
      {
        "evidence_id": "E004",
        "passage_id": "P001",
        "statement_status": "testimony_or_record",
        "quote": "Defendant owned the property on which the post office and the parking area were located, and she had leased the property to the United States Postal Service (USPS) and its predecessor since 1971."
      },
      {
        "evidence_id": "E005",
        "passage_id": "P001",
        "statement_status": "current_disposition",
        "quote": "We conclude that Supreme Court erred in denying the motion of defendant seeking summary judgment dismissing the complaint."
      },
      {
        "evidence_id": "E006",
        "passage_id": "P001",
        "statement_status": "court_finding",
        "quote": "Defendant met her initial burden by establishing that she was an out-of-possession landlord who had relinquished control of the premises to USPS"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P002",
        "statement_status": "testimony_or_record",
        "quote": "In support of the motion, defendant submitted evidence establishing that USPS created the parking area where plaintiff fell and had erected a sign restricting the parking area to post office patrons, without the knowledge or input of defendant."
      },
      {
        "evidence_id": "E008",
        "passage_id": "P002",
        "statement_status": "testimony_or_record",
        "quote": "In doing so, USPS acted pursuant to a provision in the lease agreement that permitted it to make alterations and erect additions on the property and that further provided that such improvements “shall be and remain the property of [USPS].”"
      },
      {
        "evidence_id": "E009",
        "passage_id": "P002",
        "statement_status": "court_finding",
        "quote": "There is no provision in the lease agreement that obligates defendant to maintain or repair the parking area"
      },
      {
        "evidence_id": "E010",
        "passage_id": "P002",
        "statement_status": "court_finding",
        "quote": "nor is there any evidence that she assumed such a responsibility by her conduct"
      },
      {
        "evidence_id": "E011",
        "passage_id": "P003",
        "statement_status": "court_finding",
        "quote": "While we agree with plaintiff that the description of the leased property as including a “Parking and Maneuvering” area of 1,805 square feet is ambiguous, we nevertheless conclude that the terms of the lease as a whole unambiguously grant USPS possession and control of the building and all ap *1362 purtenances comprising the post office, including the parking area at issue"
      },
      {
        "evidence_id": "E012",
        "passage_id": "P003",
        "statement_status": "court_finding",
        "quote": "Even assuming, arguendo, that the lease is ambiguous, we would nonetheless conclude that defendant is entitled to summary judgment because “all of the extrinsic evidence contained in the record weighs in favor of [defendant]’s interpretation of the lease”"
      },
      {
        "evidence_id": "E013",
        "passage_id": "P003",
        "statement_status": "court_finding",
        "quote": "plaintiff failed to submit any affidavits or other evidentiary proof in admissible form to support that contention, and plaintiff’s “ ‘mere hope’ ” that such evidence exists is insufficient to raise a triable issue of fact"
      }
    ]
