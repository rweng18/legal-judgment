    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "Appeal from an order of the Supreme Court, Erie County (Timothy J. Drury, J.), entered October 14, 2015. The order denied the motion of defendant for summary judgment dismissing the complaint.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "It is hereby ordered that the order so appealed from is unanimously affirmed without costs.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "quote": "Memorandum: In this personal injury action, plaintiffs seek damages for injuries allegedly sustained by Patricia Farrauto (plaintiff) when she tripped and fell while working for a fragrance company in a department store operated by defendant.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P002",
        "quote": "Defendant submitted excerpts of plaintiff’s deposition testimony in which she described the gift box over which she allegedly tripped, and her testimony is sufficient to enable a jury to determine that the gift box was the cause of her fall without resorting to speculation",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P003",
        "quote": "Defendant’s submissions were insufficient to establish as a matter of law that its employees did not create the allegedly dangerous condition by placing the gift box on the floor (see Guilfoyle v Parkash, 123 AD3d 1088, 1089 [2014]; Hagin v Sears, Roebuck & Co., 61 AD3d 1264, 1265-1266 [2009]; Frank v Price Chopper Operating Co., 275 AD2d 940, 941 [2000]), and defendant therefore also failed to establish that it did not have actual notice of the gift box on the floor prior to plaintiffs fall",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P004",
        "quote": "While defendant submitted evidence that its employees were generally expected to identify and remedy tripping hazards, it did not submit any evidence establishing when the area of plaintiff’s fall was last inspected",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P004",
        "quote": "Plaintiff’s testimony that she did not see the gift box before she tripped “does not establish [defendant’s] entitlement to judgment as a matter of law on the issue whether the [gift box] was visible and apparent”",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E008",
        "passage_id": "P001",
        "quote": "Even assuming, arguendo, that this contention was advanced in defendant’s initial motion papers and thus that it is properly before us",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E009",
        "passage_id": "P001",
        "quote": "We affirm.",
        "statement_status": "court_finding"
      }
