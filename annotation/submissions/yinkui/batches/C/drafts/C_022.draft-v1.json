      },
      {
        "evidence_id": "E005",
        "passage_id": "P002",
        "quote": "She presented no evidence that defendants created the condition, that it was readily apparent, or that it was present for a sufficiently long period of time so that defendants had an opportunity to remedy the alleged hazard",
