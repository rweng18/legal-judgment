        "passage_id": "P001",
        "quote": "The plaintiff allegedly tripped and fell in the parking lot of the defendants' store.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P002",
        "quote": "The plaintiff commenced this action against the defendants, the alleged owners and operators of the subject premises, to recover damages for personal injuries, alleging that they were negligent in, among other things, the maintenance of their premises.",
