    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the defendant appeals from an order of the Supreme Court, Suffolk County (William B. Rebolini, J.), dated July 3, 2017. The order denied the defendant's motion for summary judgment dismissing the complaint.",
        "statement_status": "procedural_history"
