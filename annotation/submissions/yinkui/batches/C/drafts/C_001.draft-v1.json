    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "Order, Supreme Court, New York County (Lynn R. Kotler, J.), entered on or about March 2, 2022, which granted defendant's motion for summary judgment dismissing the complaint, unanimously reversed, on the law, without costs, and the motion denied.",
