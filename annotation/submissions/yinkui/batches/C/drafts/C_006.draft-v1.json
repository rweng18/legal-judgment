    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the defendants appeal from an order of the Supreme Court, Queens County (Salvatore Modica, J.), dated January 22, 2019. The order denied the defendants' motion for summary judgment dismissing the complaint.",
