    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "Appeal from an order of the Supreme Court, Erie County (Raymond W. Walter, J.), entered June 3, 2022. The order granted the motion of defendants for summary judgment and dismissed the complaint.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "It is hereby ordered that the order so appealed from is unanimously affirmed without costs.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "quote": "Plaintiffs commenced this action seeking damages for injuries sustained by Nancy O'Neill (plaintiff) when she slipped and fell on snow and ice in a parking lot owned and managed by defendants Buffalo Southwestern, LLC and Benderson Development Company, LLC (Benderson), respectively.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P002",
        "quote": "Benderson contracted with defendant T.C. Notaro Contracting, Inc. (Notaro) for snow removal services for the property.",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P002",
        "quote": "Defendants met their initial burden on the motion of establishing as a matter of law that \"plaintiff's injuries [were] sustained as the result of an icy condition occurring during an ongoing storm or for a reasonable time thereafter",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P003",
        "quote": "Under the circumstances, we conclude that the court did not abuse its discretion in allowing defendants to correct the unsworn report by submitting the same evidence in proper form in their reply papers",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P004",
        "quote": "Finally, we reject plaintiffs' contention that, by plowing the snow from the parking lot, Notaro left it in a more dangerous condition because now any ice underneath the snow was exposed. \"[B]y merely plowing the snow, as required by the contract, [Notaro's] actions could not be said 'to have created or exacerbated a dangerous condition",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E008",
        "passage_id": "P003",
        "quote": "Contrary to plaintiffs' further contention, in opposition to the motion they failed to \"raise a triable issue of fact whether the accident was caused by a slippery condition at the location",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E009",
        "passage_id": "P004",
        "quote": "plaintiff fell that existed prior to the storm, as opposed to precipitation from the storm in progress, and that . . . defendant[s] had actual or constructive notice of the preexisting condition",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E010",
        "passage_id": "P002",
        "quote": "Although defendants submitted an unsworn report of an expert meteorologist in support of their motion, they submitted an affidavit of that same meteorologist in reply, to which he attached the same report submitted in the initial moving papers.",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E011",
        "passage_id": "P003",
        "quote": "Defendants did not submit any new facts in their reply papers ( cf. Korthas v U.S. Foodservice, Inc. , 61 AD3d 1407 , 1408 [4th Dept 2009]; Walter v United Parcel Serv. , Inc. , 56 AD3d 1187, 1187-1188 [4th Dept 2008]). We decline to follow the First Department precedent advanced by plaintiff that a defect of this nature cannot be cured on reply",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E012",
        "passage_id": "P002",
        "quote": "Although defendants submitted an unsworn report of an expert meteorologist in support of their motion, they submitted an affidavit of that same meteorologist in reply, to which he attached the same report submitted in the initial moving papers.",
        "statement_status": "court_finding"
      }
