    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the plaintiff appeals from an order of the Supreme Court, Kings County (Martin, J.), dated November 28, 2011, which granted the defendants’ motion for summary judgment dismissing the complaint.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Ordered that the order is affirmed, with costs.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "quote": "The plaintiff commenced this action after she allegedly slipped and fell on a banana peel in the 11th floor hallway of the defendants’ building. According to the plaintiff, the banana peel was located near a garbage chute, and there were several small garbage bags on the floor in front of the chute.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P001",
        "quote": "In support of their motion, the defendants submitted, inter alia, the affidavit of a building porter, who averred that he inspected the area on the day before the plaintiffs accident, just before the end of his shift, and did not observe any garbage or debris on the floor.",
        "statement_status": "testimony_or_record"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P002",
        "quote": "The defendants established their entitlement to judgment as a matter of law by demonstrating, prima facie, that they did not create the alleged hazardous condition or have actual or constructive notice of it",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P002",
        "quote": "Contrary to the plaintiffs contention, evidence that garbage bags had been left on the floor near the garbage chute on prior occasions was insufficient to raise an issue of fact as to whether the defendants had notice of a recurring dangerous condition. This evidence established only that the defendants had a general awareness that garbage bags were left on the floor near the chute, which was insufficient to charge them with notice of the particular condition that caused the plaintiff’s fall",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P003",
        "quote": "Accordingly, the Supreme Court properly granted the defendants’ motion for summary judgment dismissing the complaint.",
        "statement_status": "court_finding"
      }
