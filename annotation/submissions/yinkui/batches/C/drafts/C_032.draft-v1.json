    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "Order, Supreme Court, Bronx County (Naita A. Semaj, J.), entered September 21, 2023, which, insofar as appealed from, granted the motion of defendant Steph-Leigh Associates, LLC for summary judgment dismissing the complaint as against it, unanimously affirmed, without costs.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Steph-Leigh Associates, LLC (defendant) established its prima facie entitlement to judgment as a matter of law, where plaintiff tripped and fell over a raised door saddle at the entrance of the premises owned by defendant, and plaintiff failed to raise a triable issue of fact.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P002",
        "quote": "Defendant showed that it was an out-of-possession landlord with no duty to maintain and repair the entrance under the lease agreement, which assigned such responsibility to the tenant and granted defendant only a limited right of re-entry to repair the premises contingent on the tenant's failure to do so",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P002",
        "quote": "Furthermore, the door saddle was not structural in nature ( see Paniagua v Bridge Food Ctr. Corp. , 59 AD3d 356 , 357 [1st Dept 2009]), and plaintiff failed to allege any violation of a specific statutory provision",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P002",
        "quote": "We have considered plaintiff's remaining contentions, including that defendant had constructive notice of the raised door saddle, and find them unavailing.",
