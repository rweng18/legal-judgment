      },
      {
        "evidence_id": "E005",
        "passage_id": "P004",
        "quote": "The plaintiff also failed to raise a triable issue of fact as to whether the accident was caused by a slippery condition at the location where he allegedly fell that existed prior to the storm, as opposed to precipitation from the storm in progress",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P003",
        "quote": "In opposition, the plaintiff failed to raise a triable issue of fact as to whether the defendants' ice prevention efforts created a hazardous condition or exacerbated a natural hazard created by the storm",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P004",
        "quote": "Accordingly, the Supreme Court properly granted the defendants' motion for summary judgment dismissing the complaint.",
