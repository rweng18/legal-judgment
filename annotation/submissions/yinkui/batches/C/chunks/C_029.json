    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, etc., the defendant appeals, as limited by its brief, from so much of an order of the Supreme Court, Suffolk County (Pitts, J.), dated March 6, 2015, as denied its motion for summary judgment dismissing the complaint, and the plaintiffs cross-appeal, as limited by their brief, from so much of the same order as denied that branch of their cross motion which was for summary judgment on the issue of liability.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Ordered that the order is affirmed insofar as appealed and cross-appealed from, without costs or disbursements.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P002",
        "quote": "On December 12, 2011, the plaintiff Frances D. Giantomaso (hereinafter the injured plaintiff) allegedly slipped on ice and fell as she exited the north entrance to a building located on premises owned by the defendant.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P004",
        "quote": "Here, in support of its motion, the defendant failed to demonstrate that it lacked constructive notice, as it failed to submit any evidence as to when, prior to the subject accident, the area of the north entrance where the alleged slip and fall occurred was last inspected or cleaned",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P006",
        "quote": "Here, the plaintiffs contend, based on deposition testimony, that the icy condition was caused by the operation of a sprinkler system, exclusively in the defendant's control, in the month of December.",
        "statement_status": "party_argument"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P007",
        "quote": "The plaintiffs' evidence failed to satisfy the third element of the res ipsa loquitur doctrine, namely, that the accident and any resulting injuries was not the result of any voluntary action or contribution on the part of the injured plaintiff",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P002",
        "quote": "We affirm the order insofar as appealed and cross-appealed from, albeit on grounds other than those relied upon by the court.",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E008",
        "passage_id": "P007",
        "quote": "Accordingly, the plaintiffs failed to demonstrate their prima facie entitlement to judgment as a matter of law in support of that branch of their cross motion which was for summary judgment on the issue of liability, and the Supreme Court properly denied that branch of the plaintiffs' cross motion.",
        "statement_status": "court_finding"
      }
