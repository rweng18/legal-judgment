      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Plaintiff alleges that she slipped and fell on a slippery liquid on the interior stairs of an apartment building owned by defendant 1386 Associates, LLC, and managed by defendant SDG Management Corp. Plaintiff testified that when she began to slip, she reached for the stairs' handrail, but it was loose, and she fell.",
