    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the defendants appeal from an order of the Supreme Court, Kings County (Peter P. Sweeney, J.), dated June 25, 2018. The order denied the defendants' motion for summary judgment dismissing the complaint.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Ordered that the order is affirmed, with costs.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "quote": "On December 2, 2014, the plaintiff, then a mail carrier employed by the United States Postal Service, slipped and fell while descending an interior set of stairs in a residential building that allegedly was owned and/or managed by the defendants.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P002",
        "quote": "The plaintiff alleged that she slipped and fell due to a \"wet and slippery substance\" on the stairs.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P003",
        "quote": "The plaintiff's deposition testimony identified the cause of her fall as a wet substance on the stairs. The plaintiff's mere inability to identify the precise nature of the wet substance upon which she allegedly slipped and fell cannot be equated with a failure to identify the cause of her fall",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P004",
        "quote": "Moreover, the evidence submitted in support of the defendants' motion, especially the deposition transcripts of the plaintiff and the superintendent of the subject building, revealed triable issues of fact as to whether the defendants created the alleged condition",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P004",
        "quote": "Furthermore, we agree with the Supreme Court's conclusion that the defendants failed to present evidence regarding any specific cleaning or inspection of the area in question relative to the time when the plaintiff's accident occurred",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E008",
        "passage_id": "P005",
        "quote": "Accordingly, we agree with the Supreme Court's determination to deny the defendants' motion for summary judgment dismissing the complaint.",
        "statement_status": "current_disposition"
      }
