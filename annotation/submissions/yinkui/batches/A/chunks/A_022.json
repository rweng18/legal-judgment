    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the plaintiff appeals from an order of the Supreme Court, Richmond County (McMahon, J.), entered April 4, 2013, which granted the defendant's motion for summary judgment dismissing the complaint.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Ordered that the order is reversed, on the law, with costs, and the defendant's motion for summary judgment dismissing the complaint is denied.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "quote": "The plaintiff commenced this action to recover damages for personal injuries allegedly sustained by her when she fell while descending an interior stairway within premises owned by the defendant and improved with a multiple dwelling.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P002",
        "quote": "In her complaint, the plaintiff asserted that she was at the premises visiting a friend in the basement of the building, when she fell down the interior stairway. The plaintiff contended that she slipped and fell because of poor lighting and the lack of a handrail.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P002",
        "quote": "The defendant's submissions in support of its motion included, among other things, a transcript of the deposition testimony of the plaintiff, in which the plaintiff testified that, as she was descending the stairs, she took one step with her right foot and \"slipped,\" and that she \"went to grab on, to try to hold [herself but] there was nothing to grab onto so [she] went all the way down.\" It is undisputed that the stairs in question were not furnished with a handrail.",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P003",
        "quote": "The defendant failed to establish its prima facie entitlement to judgment as a matter of law, as its submissions failed to eliminate all triable issues of fact as to whether a handrail was statutorily required at the location where the plaintiff fell",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P003",
        "quote": "Moreover, the plaintiff's deposition testimony, which was submitted by the defendant in support of [*2] its motion, revealed the existence of a triable issue of fact as to whether the lack of a handrail was a proximate cause of the plaintiff's injuries",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E008",
        "passage_id": "P004",
        "quote": "Accordingly, the Supreme Court should have denied the defendant's motion for summary judgment dismissing the complaint.",
        "statement_status": "current_disposition"
      }
    ],
