    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the plaintiff appeals from an order of the Supreme Court, Kings *917 County (Bayne, J.), dated December 15, 2008, which granted the defendants’ separate motions for summary judgment dismissing the complaint insofar as asserted against each of them.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Ordered that the order is affirmed, with one bill of costs.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "quote": "The plaintiff slipped and fell inside premises owned by the defendant 59 Realty, Inc., as she was about to descend the stairs leading to a store operated by the defendant Surgical Sock Shop II, Inc. The plaintiff claims that she slipped due to the wet condition of the staircase landing, which allegedly was caused by tracked-in water or snow.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P002",
        "quote": "Contrary to the plaintiffs contention, both defendants made a prima facie showing of their entitlement to judgment as a matter of law by presenting sufficient evidence to demonstrate that they neither created the alleged wet condition, nor had actual or constructive notice of the condition for a sufficient length of time for their employees to have discovered and remedied it",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P003",
        "quote": "In opposition, the plaintiff failed to raise a triable issue of fact (see Pinto v Metropolitan Opera, 61 AD3d at 950 ; Akhtar v Zucker, 50 AD3d at 933 ; Gullo-Georgio v Dunkin’ Donuts Inc., 38 AD3d at 837 ; Hackbarth v McDonalds Corp., 31 AD3d at 499 ).",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P002",
        "quote": "However, the business owner or operator is not obligated to provide a constant remedy to the problem of water or snow being tracked into the store caused by inclement weather” (Hackbarth v McDonalds Corp., 31 AD3d 498, 498-499 [2006] [internal citations and quotation marks omitted]; see Gullo-Georgio v Dunkin’ Donuts Inc., 38 AD3d 836 [2007]). A property owner similarly is not required to constantly remove all moisture resulting from tracked-in precipitation (see Curtis v Dayton Beach Park No. 1 Corp., 23 AD3d 511 [2005]; Murphy v Lawrence Towers Apts., LLC, 15 AD3d 371 [2005]; Yearwood v Cushman & Wakefield, 294 AD2d 568 [2002]).",
        "statement_status": "court_finding"
      }
    ],
