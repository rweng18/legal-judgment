      },
      {
        "evidence_id": "E003",
        "passage_id": "P002",
        "quote": "The plaintiff allegedly was injured when she slipped and fell on a wet linoleum floor in the vestibule of a condominium building. She commenced this action against the defendants, who are owners of individual units in the condominium.",
        "statement_status": "allegation"
      },
