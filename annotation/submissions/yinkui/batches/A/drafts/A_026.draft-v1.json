    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the plaintiff appeals from an order of the Supreme Court, Nassau County (R. Bruce Cozzens, Jr., J.), dated April 8, 2021. The order granted the defendant's motion for summary judgment dismissing the complaint.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Ordered that the order is reversed, on the law, with costs, and the defendant's motion for summary judgment dismissing the complaint is denied.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "quote": "The plaintiff commenced this action to recover damages for personal injuries she allegedly sustained when she tripped and fell over a white flowerpot located next to a white column on the landing of premises owned by the defendant.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P002",
        "quote": "At her deposition, the plaintiff testified that, on the day at issue, she was standing on the landing outside the defendant's front door speaking with the defendant, who was standing in the doorway. The plaintiff testified that when the defendant moved the outer screen door toward her, she stepped back into the object, lost her balance, and fell from the landing.",
        "statement_status": "testimony_or_record"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P003",
        "quote": "Here, the defendant failed to establish, prima facie, that the alleged condition was open and obvious and not inherently dangerous under the circumstances surrounding the accident",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P004",
        "quote": "Since the defendant failed to establish his prima facie entitlement to judgment as a matter of law, the Supreme Court should have denied his motion for summary judgment dismissing the complaint, regardless of the sufficiency of the plaintiff's opposition papers",
        "statement_status": "current_disposition"
      }
    ],
