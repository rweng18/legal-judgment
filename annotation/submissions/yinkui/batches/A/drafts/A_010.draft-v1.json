    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the defendant appeals from an order of the Supreme Court, Nassau County (R. Bruce Cozzens, Jr., J.), entered April 14, 2021. The order denied the defendant's motion for summary judgment dismissing the complaint.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Ordered that the order is reversed, on the law, with costs, and the defendant's motion for summary judgment dismissing the complaint is granted.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "quote": "On December 21, 2017, at approximately 12:45 p.m., the plaintiff fell down a staircase inside a building owned by the defendant.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P002",
        "quote": "As the plaintiff descended the stairs, there was a handrail on the right side but not on the left side of the staircase.",
