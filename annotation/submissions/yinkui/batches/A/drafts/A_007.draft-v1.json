    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "Appeal from an order of the Supreme Court, Erie County (Paula L. Feroleto, J.), entered June 2, 2021. The order granted the motion of defendants for summary judgment and dismissed the complaint.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "It is hereby ordered that the order so appealed from is unanimously affirmed without costs.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "quote": "Plaintiff commenced this action seeking damages for injuries she sustained when she slipped and fell on a clear liquid while walking down an aisle in a Dollar General Store owned by defendant 9274 Group, Inc., which leased the premises to defendant Dolgencorp of New York, Inc.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P002",
        "quote": "Here, defendants met their initial burden of establishing the lack of constructive notice as a matter of law through the affidavit of the assistant store manager, who stated that she inspected the premises every 30 minutes to check for safety hazards, and that she walked down the aisle in question approximately 15 minutes before plaintiff fell and did not see anything on the floor. The assistant manager offered deposition testimony that is generally consistent with her affidavit.",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P003",
        "quote": "In opposition to the motion, plaintiff relied largely on footage from surveillance cameras inside the store that, according to plaintiff, call into question the assistant manager's assertions that she inspected the area 15 minutes before the accident. Based on our review of the relevant footage, which does not capture the area where plaintiff fell, we conclude that it neither confirms nor refutes the sworn assertions of the assistant manager with respect to her inspection of that area, and that the court therefore properly concluded that plaintiff failed to raise an issue of fact sufficient to defeat defendants' motion for summary judgment.",
        "statement_status": "court_finding"
      }
    ],
