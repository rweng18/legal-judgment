    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the defendant appeals from an order of the Supreme Court, Dutchess County (Brands, J.), dated December 17, 2010, which denied its motion for summary judgment dismissing the complaint.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Ordered that the order is affirmed, without costs or disbursements.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "quote": "The plaintiff, while in the process of exiting his apartment building, which was owned by the defendant, allegedly slipped and fell on a mat situated outside the door to the building.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P001",
        "quote": "At his deposition, the plaintiff testified that, after he stepped on the mat with his right foot, the mat, which had been located in *803 the same position for “[y]ears,” moved, causing him to lose his balance and fall.",
        "statement_status": "testimony_or_record"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P002",
        "quote": "According to the plaintiffs deposition testimony, submitted by the defendant in support of its motion, all four of the corners of the mat, which had been on the premises for “a very long time,” were turned up, and the mat would frequently move out of its position when he would step on it, causing him to have to reposition it.",
        "statement_status": "testimony_or_record"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P003",
        "quote": "Since the defendant offered no evidence as to when the mat was last inspected prior to the accident, as opposed to the last time its superintendent walked over it, the defendant failed to make a prima facie showing that it did not have constructive notice of the alleged defective condition of the mat",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P003",
        "quote": "Moreover, contrary to the defendant’s contention, it failed to establish, prima facie, that the condition which allegedly caused the plaintiff’s accident was not hazardous",
        "statement_status": "court_finding"
      }
