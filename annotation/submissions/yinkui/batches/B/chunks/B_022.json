    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the defendant New Docs, LLC, appeals from an order of the Supreme Court, Queens County (Chereé A. Buggs, J.), entered June 5, 2018. The order, insofar as appealed from, denied that defendant's motion for summary judgment dismissing the complaint and all cross claims insofar as asserted against it.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P002",
        "quote": "Ordered that the order is affirmed insofar as appealed from, with one bill of costs.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P002",
        "quote": "The plaintiff allegedly was injured when he slipped and fell on the floor of a restaurant owned by the defendant New Docs, LLC (hereinafter the defendant), which had been flooded with one to two inches of water.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P003",
        "quote": "Contrary to the defendant's contention, it failed to demonstrate, prima facie, that it did not create the condition that caused the accident, as it failed to submit sufficient evidence to establish what caused the flooding on the floor of its premises",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P004",
        "quote": "However, the plaintiff's theory of liability in this action is that the defendant failed to maintain its premises in a reasonably safe condition, not that it failed to warn him of a dangerous condition. \"Although there is no duty to warn of an open and obvious condition, this principle does not absolve a landowner of the duty to maintain the property in a reasonably safe condition\" ( Mooney v Petro, Inc. , 51 AD3d 746 , 747 [2008]). Contrary to the defendant's additional contention, the plaintiff's conduct of walking on the flooded floor was not so extraordinary, culpable, or unforeseeable as to supersede the defendant's alleged negligence and constitute the sole proximate cause of the accident",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P003",
        "quote": "has the initial burden of making a prima facie showing that it neither created the hazardous condition nor had actual or constructive notice of its existence for a sufficient length of time to discover and remedy it",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P005",
        "quote": "Accordingly, we agree with the Supreme Court's determination denying the defendant's motion for summary judgment dismissing the complaint and all cross claims insofar as asserted against it, regardless of the sufficiency of the opposition papers",
        "statement_status": "court_finding"
      }
