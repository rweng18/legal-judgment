    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the plaintiff appeals from an order of the Supreme Court, Kings County (Consuelo Mallafre Melendez, J.), dated April 11, 2022. The order granted the defendant's motion for summary judgment dismissing the complaint.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Ordered that the order is reversed, on the law, with costs, and the defendant's motion for summary judgment dismissing the complaint is denied.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "quote": "New York City Department of Education, Respondent.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P001",
        "quote": "The plaintiff allegedly sustained personal injuries at the defendant's premises and commenced this action against the defendant.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P002",
        "quote": "According to the plaintiff, she was sitting behind a desk and when she got up, she tripped on the bottom desk drawer which, unbeknownst to her, had become ajar.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P004",
        "quote": "Here, the defendant failed to establish, prima facie, that the condition of the desk drawer that caused the plaintiff to fall was open and obvious and not inherently dangerous",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P005",
        "quote": "In addition, the defendant failed to establish, prima facie, that it did not have actual or constructive notice of a defective condition that caused the plaintiff to fall ( see Marazita v City of New York , 202 AD3d 951 , 954 [2022]; Mercedes v City of New York , 107 AD3d 767 , 769 [2013]). The deposition testimony of the school's temporary custodial engineer generally stated his general inspection practices and that he did not have recollection of any problems with any of the desks in the school in February. He further testified that he had only been working at the school for a few days prior to the accident ( see Mercedes v City of New York , 107 AD3d 767 [2013]). Triable issues of fact exist as to whether the defendant had actual or constructive notice of the hazardous condition and whether the alleged hazardous condition existed for a sufficient amount of time for the defendant to discover and remedy it",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E008",
        "passage_id": "P003",
        "quote": "In a premises liability case, a defendant property owner, or a party in possession or control of real property, who moves for summary judgment has the initial burden of making a prima facie showing that it neither created the alleged defective condition nor had actual or constructive [*2] notice of its existence",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E009",
        "passage_id": "P006",
        "quote": "Accordingly, the Supreme Court should have denied the defendant's motion for summary judgment dismissing the complaint, regardless of the sufficiency of the plaintiff's papers in opposition",
        "statement_status": "court_finding"
      }
    ],
