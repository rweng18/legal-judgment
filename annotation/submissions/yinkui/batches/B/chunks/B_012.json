    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the defendants appeal from an order of the Supreme Court, Kings County (Wade, J.), dated October 7, 2016, which denied their motion for summary judgment dismissing the complaint.",
