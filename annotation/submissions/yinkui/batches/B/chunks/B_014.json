    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, etc., the defendant appeals from an order of the Supreme Court, Putnam County (Lubell, J.), dated September 16, 2014, which denied its motion for summary judgment dismissing the complaint.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Ordered that the order is affirmed, with costs.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "quote": "The plaintiff Thomas Burniston (hereinafter the injured plaintiff) alleged that on January 7, 2009, at approximately 7:30 a.m., he slipped and fell due to an accumulation of snow and ice in a parking lot owned by the defendant.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P003",
        "quote": "The evidence submitted by the defendant in support of its motion for summary judgment, including certified climatological data, a report from the plaintiffs' own expert meteorologist, and the transcripts of the deposition testimony of the parties, demonstrated, prima facie, that a storm was in progress at the time of the subject accident",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P004",
        "quote": "The evidence relied upon by the plaintiffs in opposition to the defendant's motion, which included the report of their expert meteorologist, certified climatological data, and the affidavits of the injured plaintiff and two nonparty witnesses, raised a triable issue of fact as to whether the injured plaintiff slipped and fell on old snow and ice that was the product of a prior storm, as opposed to precipitation from the storm in progress, and as to whether the defendant had constructive notice of the preexisting condition",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P002",
        "quote": "A property owner will be held liable for a slip-and-fall accident involving snow and ice on its property only when it created the dangerous condition which caused the accident or had actual or constructive notice of its existence",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P005",
        "quote": "Accordingly, the Supreme Court properly denied the defendant's motion for summary judgment.",
        "statement_status": "court_finding"
      }
