    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the plaintiff appeals from an order of the Supreme Court, Westchester County (Sam D. Walker, J.), dated December 22, 2021. The order granted the defendant's motion for summary judgment dismissing the complaint.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Ordered that the order is reversed, on the law, with costs, and the defendant's motion for summary judgment dismissing the complaint is denied.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "quote": "On April 24, 2019, the plaintiff allegedly slipped and fell on an oily substance on the ground of the exterior parking lot of the defendant's shopping mall.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P003",
        "quote": "Here, the defendant failed to establish, prima facie, that it did not have constructive notice of the condition that allegedly caused the plaintiff to fall",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P003",
        "quote": "The plaintiff testified at her deposition that she saw the oily patch on the ground of the parking lot on her way into the shopping mall, approximately an hour before she slipped and fell after exiting the mall. The defendant's property manager only testified about the defendant's general cleaning and inspection procedures.",
        "statement_status": "testimony_or_record"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P004",
        "quote": "The defendant's contention that the presence of the oily substance on the ground of the parking lot was incidental to the use of the premises is without merit ( see Gambino v City of New York , 60 AD3d 627 [2009]). Contrary to the defendant's contention, the fact that the oily substance was open and obvious only raised a triable issue of fact as to the issue of the plaintiff's comparative negligence",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P004",
        "quote": "Accordingly, the Supreme Court should have denied the defendant's motion for summary judgment dismissing the complaint.",
        "statement_status": "court_finding"
      }
