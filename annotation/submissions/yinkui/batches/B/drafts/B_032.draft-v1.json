    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the defendant appeals from an order of the Supreme Court, Kings County (Carolyn E. Wade, J.), dated November 22, 2019. The order denied the defendant's motion for summary judgment dismissing the complaint.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Ordered that the order is affirmed, without costs or disbursements.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "quote": "The plaintiff allegedly was injured when, on a rainy morning, she slipped and fell inside a vestibule of a building owned by the defendant.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P001",
        "quote": "Tamara Vinokurova, Respondent, v Edith and Carl Marks Jewish Community House of Bensonhurst, Inc., Appellant.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P004",
        "quote": "Here, the evidence submitted by the defendant in support of its motion failed to demonstrate, prima facie, that it lacked constructive notice of the alleged dangerous condition that caused the plaintiff to fall. The defendant's building manager testified only as to the building's general cleaning and inspection practices—the defendant did not proffer any evidence demonstrating when the vestibule was last cleaned or inspected before the accident",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P002",
        "quote": "While a defendant is not required to cover all of its floors with mats, or to continuously mop up all moisture resulting from tracked-in precipitation",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P003",
        "quote": "a defendant may be held liable for an injury proximately caused by a dangerous condition created by water, snow, or ice tracked into a building if it either created the hazardous condition, or had actual or constructive notice of the condition and a reasonable time to undertake remedial action",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E008",
        "passage_id": "P004",
        "quote": "Accordingly, the Supreme Court properly denied the defendant's motion for summary judgment dismissing the complaint.",
        "statement_status": "court_finding"
      }
