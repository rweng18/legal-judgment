    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, etc., the plaintiff appeals from a judgment of the Supreme Court, Queens County (Robert L. Nahman, J.), entered March 15, 2017. The judgment, upon a jury verdict on the issue of liability, is in favor of the defendants and against the plaintiff dismissing the complaint.",
