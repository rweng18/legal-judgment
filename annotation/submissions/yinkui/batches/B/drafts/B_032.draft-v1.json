    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, etc., the plaintiffs appeal from an order of the Supreme Court, Westchester County (Linda S. Jamieson, J.), dated August 26, 2020. The order granted the defendant's motion for summary judgment dismissing the complaint.",
