    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the defendant appeals from an order of the Supreme Court, Richmond County (Orlando Marrazzo, Jr., J.), dated March 3, 2022. The order denied the defendant's motion for summary judgment dismissing the complaint.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Ordered that the order is reversed, on the law, with costs, and the defendant's motion for summary judgment dismissing the complaint is granted.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "quote": "The plaintiff commenced this action to recover damages for personal injuries she allegedly sustained on July 2, 2018, at approximately 4:00 p.m., when she slipped and fell on food on the floor of the defendant's store.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P003",
        "quote": "Here, the defendant established, prima facie, that it did not create or have actual or constructive notice of the condition alleged by the plaintiff to have caused the accident.",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P003",
        "quote": "In support of its motion, the defendant submitted, inter alia, the deposition testimony of its employee, as well as the \"Daily Floor-walk / Safety Inspection\" record for the day of the incident, which demonstrated that the area in question was last inspected between 2:47 p.m. and 3:40 p.m. on the date of the accident and that no hazardous condition was found in that location",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P004",
        "quote": "The employee testified that if he had observed any hazardous condition on the floor, he would have immediately cleaned it",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P004",
        "quote": "Accordingly, the Supreme Court should have granted the defendant's motion for summary judgment dismissing the complaint.",
        "statement_status": "court_finding"
      }
    ],
