    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "Order, Supreme Court, New York County (Walter B. Tolub, J.), entered January 14, 2009, which, in an action for personal injuries sustained in a slip and fall in defendants-respondents’ (defendants) supermarket, denied plaintiffs motion to vacate a prior order that had granted defendants’ motion for summary judgment upon plaintiffs default, unanimously affirmed, without costs.",
