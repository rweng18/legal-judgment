    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the plaintiff appeals from so much of an order of the Supreme Court, Queens County (Livote, J.), entered September 15, 2015, as, upon reargument, adhered to a prior determination in an order of the same court entered April 1, 2015, granting the defendant's motion for summary judgment dismissing the complaint.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Ordered that the order is affirmed insofar as appealed from, with costs.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "quote": "On April 4, 2012, at approximately 10:30 a.m., the plaintiff allegedly tripped and fell over a wheel stop in a parking space at a small supermarket located in Great Neck.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P002",
        "quote": "At the time of the accident, the premises were owned by the defendant.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P003",
        "quote": "Here, the defendant established its prima facie entitlement to judgment as a matter of law by submitting, inter alia, the plaintiff's deposition testimony and photographic evidence [*2] demonstrating that the plaintiff tripped when her foot came into contact with a wheel stop that was open and obvious and not inherently dangerous. Among other things, the plaintiff testified at her deposition that she noticed the yellow cement wheel stops in the parking lot shortly before her accident",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P002",
        "quote": "Although a landowner has a duty to maintain its premises in a reasonably safe manner ( see Basso v Miller , 40 NY2d 233, 241-242 [1976]), there is no duty to protect or warn against an open and obvious condition that is not inherently dangerous",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P002",
        "quote": "We affirm insofar as appealed from.",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E008",
        "passage_id": "P004",
        "quote": "Accordingly, upon reargument, the Supreme Court properly adhered to its prior determination granting the defendant's motion for summary judgment dismissing the complaint.",
        "statement_status": "court_finding"
      }
    ],
