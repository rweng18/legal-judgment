    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the plaintiff appeals from an order of the Supreme Court, Westchester County (David F. Everett, J.), dated June 23, 2017. The order granted the defendants' motion for summary judgment dismissing the complaint.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Ordered that the order is reversed, on the law, with costs, and the defendants' motion for summary judgment dismissing the complaint is denied.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "quote": "On February 23, 2015, the plaintiff allegedly slipped and fell on a wet condition in the produce aisle of the defendants' supermarket.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P003",
        "quote": "Here, the defendants failed to establish, prima facie, that they did not create the allegedly dangerous condition that caused the plaintiff's accident ( see Paar v Sky Foods Mkt., Inc. , 172 AD3d 1082 , 1082 [2019]; Marino v Stop & Shop Supermarket Co. , 21 AD3d 531 , 532 [2005]). The defendants' submissions in support of their motion failed to affirmatively demonstrate that the wet condition on the floor was not created by water and melted ice leaking from an asparagus display, which was adjacent to the location of the plaintiff's fall.",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P002",
        "quote": "A defendant moving for summary judgment in a slip-and-fall case has the initial burden of establishing that it neither created the hazardous condition that allegedly caused the fall, nor had actual or constructive notice of that condition for a sufficient length of time to discover and remedy it",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P003",
        "quote": "Since the defendants failed to make a prima facie showing that they did not create the condition complained of, their motion for summary judgment dismissing the complaint should have been denied, regardless of the sufficiency of the plaintiff's opposition papers",
        "statement_status": "court_finding"
      }
    ],
