    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the defendants appeal from an order of the Supreme Court, Kings County (Devin P. Cohen, J.), dated January 31, 2018. The order denied the defendants' motion for summary judgment dismissing the complaint.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Ordered that the order is reversed, on the law, with costs, and the defendants' motion for summary judgment dismissing the complaint is granted.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "quote": "On February 21, 2015, at about 7:00 p.m., the plaintiff allegedly slipped and fell on snow on the marble tile floor of the vestibule of the defendants' supermarket in Brooklyn.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P003",
        "quote": "Here, the defendants established their prima facie entitlement to judgment as a matter of law by demonstrating that they did not create the alleged hazardous condition in the vestibule or have actual or constructive notice of its existence for a sufficient length of time to have discovered and remedied it",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P003",
        "quote": "In opposition, the plaintiff failed to raise a triable issue of fact.",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P002",
        "quote": "While a defendant is not required to cover all of its floors with mats, or to continuously mop up all moisture resulting from tracked-in precipitation",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P003",
        "quote": "a defendant may be held liable for an injury proximately caused by a dangerous condition created by water, snow, or ice tracked into a building if it either created the hazardous condition, or had actual or constructive notice of the condition and a reasonable time to undertake remedial action",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E008",
        "passage_id": "P003",
        "quote": "Accordingly, the Supreme Court should have granted the defendants' motion for summary judgment dismissing the complaint.",
