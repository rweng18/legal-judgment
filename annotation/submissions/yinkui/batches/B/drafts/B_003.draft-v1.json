    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the defendant Cushman & Wakefield, Inc., appeals from an order of the Supreme Court, Kings County (Kathy J. King, J.), dated January 24, 2018. The order, insofar as appealed from, denied that defendant's motion for summary judgment dismissing the amended complaint insofar as asserted against it.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Ordered that the order is affirmed insofar as appealed from, with costs.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P002",
        "quote": "Services of New York, Inc. (hereinafter SEB), for a building located in Manhattan which was owned by the defendant New York Mercantile Exchange, Inc. (hereinafter NYME), allegedly slipped and fell on water inside the building.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P001",
        "quote": "On June 23, 2011, the plaintiff, who was a security guard employed by the defendant S.E.B.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P002",
        "quote": "In June 2011, C&W managed the subject building, which included providing janitorial services.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P003",
        "quote": "The plaintiff testified that he slipped on dirty water as he traversed the hallway leading to the loading dock area, where janitors would wash trash cans inside large sinks with hoses.",
        "statement_status": "testimony_or_record"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P003",
        "quote": "Contrary to C&W's contention, the plaintiff's deposition testimony was insufficient to demonstrate, prima facie, that it did not create the alleged hazardous condition",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E008",
        "passage_id": "P002",
        "quote": "The Supreme Court denied the motion without prejudice to renew after the completion of discovery.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E009",
        "passage_id": "P002",
        "quote": "A defendant who moves for summary judgment in a slip-and-fall case has the initial burden of establishing, prima facie, that it neither created the hazardous condition nor had actual or constructive notice of its existence",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E010",
        "passage_id": "P003",
        "quote": "Here, in support of its motion, besides providing copies of the pleadings and a copy of an order related to prior motions as exhibits, C&W only submitted a transcript of the plaintiff's deposition testimony.",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E011",
        "passage_id": "P003",
        "quote": "besides providing copies of the pleadings and a copy of an order related to prior motions as exhibits",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E012",
        "passage_id": "P003",
        "quote": "Accordingly, we agree with the Supreme Court's determination to deny C&W's motion for summary judgment dismissing the amended complaint insofar as asserted against it regardless of the sufficiency of the opposition papers",
        "statement_status": "court_finding"
      }
