    "evidence": [
      {
        "evidence_id": "E001",
        "passage_id": "P001",
        "quote": "In an action to recover damages for personal injuries, the defendant appeals from an order of the Supreme Court, Suffolk County (Molia, J.), dated March 31, 2016, which denied its motion for summary judgment dismissing the complaint.",
        "statement_status": "procedural_history"
      },
      {
        "evidence_id": "E002",
        "passage_id": "P001",
        "quote": "Ordered that the order is affirmed, with costs.",
        "statement_status": "current_disposition"
      },
      {
        "evidence_id": "E003",
        "passage_id": "P001",
        "quote": "On October 8, 2012, the plaintiff allegedly slipped and fell due to the presence of a foreign substance on the floor of premises owned by the defendant.",
        "statement_status": "allegation"
      },
      {
        "evidence_id": "E004",
        "passage_id": "P003",
        "quote": "Here, although the evidence submitted in support of the defendant's motion demonstrated, prima facie, that it did not create or have actual notice of the alleged condition, its submissions failed to eliminate all triable issues of fact as to whether it had constructive notice of the alleged condition",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E005",
        "passage_id": "P003",
        "quote": "Further, the defendant failed to establish, prima facie, that the cause of the plaintiff's fall cannot be identified without engaging in speculation",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E006",
        "passage_id": "P003",
        "quote": "Rather, it means only that a plaintiff's inability to establish the cause of his or fall—whether by personal knowledge or by other admissible proof—is fatal to a cause of action based on negligence",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E007",
        "passage_id": "P002",
        "quote": "We affirm.",
        "statement_status": "court_finding"
      },
      {
        "evidence_id": "E008",
        "passage_id": "P004",
        "quote": "Inasmuch as the defendant failed to establish its prima facie entitlement to judgment as a matter of law, the Supreme Court properly denied its motion for summary judgment dismissing the complaint, regardless of the sufficiency of the opposition papers",
        "statement_status": "court_finding"
      }
